# Copy to backend/.env and fill in. Never commit backend/.env.

# OpenRouter API key (same key as the frontend project). (required)
# Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# LLM model on OpenRouter. Keep it cheap, this is a portfolio project.
LLM_MODEL=minimax/minimax-m3
# LLM_TEMPERATURE=0.8
# LLM_MAX_TOKENS=6000
# LLM_TIMEOUT_SECONDS=90
# How often invalid LLM output may be sent back for repair (max 5).
# MAX_REPAIR_ATTEMPTS=5

# Frontend origins allowed to call the API (comma-separated).
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Redis for rate-limit counters. Empty = in-memory (fine for local dev).
# docker-compose sets this automatically, no need to fill it in on the VPS.
# REDIS_URL=redis://localhost:6379/0

# Host port the API is published on (127.0.0.1 only). Change if 8000 is taken.
# API_PORT=8000

# Rate limits (defaults shown).
# RATELIMIT_PER_IP_DAILY=15
# RATELIMIT_PER_IP_BURST=5
# RATELIMIT_GLOBAL_DAILY=300
