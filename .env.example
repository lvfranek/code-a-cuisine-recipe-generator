# OpenRouter API key — used server-side by /api/generate only. (required)
# Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# --- Rate limiting (all optional) ---------------------------------------------
# Without Upstash, /api/generate uses a best-effort in-memory limiter (per
# serverless instance). Add an Upstash Redis store (Vercel Marketplace, free
# tier) and set these to make the limits shared + reliable across instances.
# The Vercel KV integration sets KV_REST_API_URL / KV_REST_API_TOKEN instead —
# those are picked up automatically too.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Limits (defaults shown). Override if you want.
# RATELIMIT_PER_IP_DAILY=15
# RATELIMIT_PER_IP_BURST=5
# RATELIMIT_GLOBAL_DAILY=300
